# Makefile is generated by cmini-makefiles.py

top_srcdir = .

all: subdirs

subdirs:
	$(MAKE) -C asm
	$(MAKE) -C cmini

test:
	sh tests/build-test.sh

test-lexer:
	LEXER=lexer sh tests/build-test.sh

test-translate:
	sh tests/build-translate.sh

test-tcc:
	sh tests/build-tcc.sh

test-asm:
	$(MAKE) -C asm test test-nasm test-nasm64 test-toaru

vystup: all
	sh tests/output.sh

test-quick: all
	$(MAKE) test test-asm test-translate test-tcc

test-all: all
	$(MAKE) test-quick
	$(MAKE) test-lexer
	VYSTUP_TOARU=0 sh tests/output.sh

test-toaru-all: all
	sh tests/04-toaruos-tcc.sh
	toaruos-tools/check.sh

# CLEAN

CLEAN_FILES =

clean:
	- rm -rf $(top_srcdir)/_build $(top_srcdir)/_output
	test -z "$(CLEAN_FILES)" || rm -f $(CLEAN_FILES)
	$(MAKE) -C asm clean
	$(MAKE) -C cmini clean

.PHONY: all clean subdirs test test-lexer test-translate test-tcc test-asm vystup test-quick test-all test-toaru-all
