CC = gcc
CFLAGS += -std=gnu99 -lncursesw -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -Os -s -g0
#CFLAGS += -std=gnu99 -lncursesw -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -g

SOURCES = mc.c cmd.c operations.c dialog.c filelist.c init.c panel.c ui.c view_edit.c progress.c

# mc: the program built by gcc (original build).
mc: *.c *.h Makefile
	$(CC) mc.c cmd.c operations.c dialog.c filelist.c init.c panel.c ui.c view_edit.c progress.c $(CFLAGS) -o mc

# mc-cmini: the same sources compiled by cmini (../cmini/cmini.bin) and linked with
# glibc and ncursesw.  cmini sees only cmini/cmini_libc.h (generated by
# cmini/gen_libc.py), so -I cmini and no system headers.
CMINI ?= ../cmini/cmini.bin
CMINI_OBJS = $(SOURCES:.c=.cmini.o)

cmini-compiler:
	@test -x "$(CMINI)" || $(MAKE) -C ../cmini/cmini cmini.bin

cminirt.o: ../cmini/cminirt.c
	$(CC) -std=gnu11 -w -c ../cmini/cminirt.c -o $@

%.cmini.o: %.c *.h cmini/cmini_libc.h
	$(CMINI) -I cmini -c $@ $<

mc-cmini: cmini-compiler $(CMINI_OBJS) cminirt.o
	$(CC) -no-pie $(CMINI_OBJS) cminirt.o -o $@ -lncursesw

.PHONY: clean mc-cmini cmini-compiler

clean:
	rm -f mc mc-cmini *.cmini.o cminirt.o
	rm -f TAGS
